# Build output and dependencies are ignored by frontend/.gitignore and
# backend/.gitignore. This file is for things that apply repo-wide.

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp

# Logs
*.log

# Local environment overrides
.env
.env.local

# Firebase service account keys. These grant full admin access to the Firebase
# project, so they are supplied per developer through
# GOOGLE_APPLICATION_CREDENTIALS and must never be committed.
*serviceaccount*.json
firebase-adminsdk*.json

# Root-level Supabase CLI dependencies
/node_modules/
